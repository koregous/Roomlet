# ============================================================================
# Roomlet Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git (it's in .gitignore)
# ============================================================================

# ── Supabase Configuration ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# ── Cloudflare R2 Configuration ─────────────────────────────────────────────
# Get these from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# Required for file uploads (images, audio, avatars, banners)

R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"

# R2 Public Domain (optional but recommended for production)
# Set up custom domain in Cloudflare R2 dashboard → Settings → Public Access
# NEXT_PUBLIC_R2_DOMAIN="https://assets.yourdomain.com"

# ── Optional: Site URL (for metadata/OG images) ─────────────────────────────
# Leave empty for local development, set for production
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ── Optional: Email Service (for admin notifications) ───────────────────────
# Currently not implemented, but reserved for future use
# RESEND_API_KEY="your_resend_api_key"
# ADMIN_EMAIL="admin@yourdomain.com"

# ============================================================================
# Setup Instructions:
# ============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your Supabase credentials
# 3. Fill in your R2 credentials
# 4. Run database migrations (see db/migrations/README.md)
# 5. Start dev server: npm run dev
# 
# R2 Setup Guide:
# ============================================================================
# 1. Create R2 bucket: https://dash.cloudflare.com → R2 → Create bucket
# 2. Generate API tokens: R2 → Manage R2 API Tokens → Create API Token
#    - Permissions: Object Read & Write
#    - Copy Account ID, Access Key ID, Secret Access Key
# 3. (Optional) Set up custom domain for public access:
#    - R2 → Your Bucket → Settings → Public Access → Connect Domain
#    - Add NEXT_PUBLIC_R2_DOMAIN to .env.local
# ============================================================================
